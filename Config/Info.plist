<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the Info.plist Xcode generates; only what has no build setting. -->
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>VaultSearch.sdef</string>
	<!-- Other names Siri accepts for the app, e.g. “Notizen in Notizsuche finden”. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Notizsuche</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Notiz suche</string>
		</dict>
	</array>
</dict>
</plist>
